{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cbsim/failure-record-v0.1.schema.json",
  "title": "CBSim failed evaluation record",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "run", "model", "working_point", "design_variables", "outcome", "issues", "solver_attempts", "reproduction"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "parent_evaluation_id": {"type": ["string", "null"]},
    "run": {
      "type": "object",
      "required": ["run_id", "seed", "algorithm"],
      "properties": {
        "run_id": {"type": "string"},
        "case_id": {"type": ["string", "null"]},
        "seed": {"type": ["integer", "null"]},
        "algorithm": {"type": "string"},
        "generation": {"type": ["integer", "null"]},
        "individual_index": {"type": ["integer", "null"]},
        "worker_pid": {"type": ["integer", "null"]},
        "hostname": {"type": ["string", "null"]}
      }
    },
    "model": {
      "type": "object",
      "required": ["wp", "cb_config", "cb_class", "fluid_hp", "fluid_he"],
      "properties": {
        "wp": {"type": "string"},
        "cb_config": {"type": "string"},
        "cb_class": {"type": "string"},
        "fluid_hp": {"type": "string"},
        "fluid_he": {"type": "string"},
        "objectives": {"type": "array", "items": {"type": "string"}}
      }
    },
    "working_point": {
      "type": "object",
      "required": ["T_hs_C", "T_cs_C"],
      "properties": {
        "T_hs_C": {"type": "number"},
        "T_cs_C": {"type": "number"},
        "delta_T_K": {"type": "number"},
        "T_st_ht_min_C": {"type": "number"},
        "T_st_ht_max_C": {"type": "number"},
        "dT_st_sp_min_K": {"type": "number"},
        "dT_st_sp_max_K": {"type": "number"}
      }
    },
    "design_variables": {
      "type": "object",
      "required": ["T_st_ht_C", "dT_st_sp_K", "dT_hp_cs_gl_K", "dT_hp_ev_sh_K", "dT_he_ev_sh_K", "dT_hp_cd_sc_K", "eta_max_cp", "eta_max_ex", "eta_pm"],
      "additionalProperties": {
        "type": "object",
        "required": ["value", "lb", "ub"],
        "properties": {
          "value": {"type": "number"},
          "lb": {"type": "number"},
          "ub": {"type": "number"},
          "out_of_bounds": {"type": "boolean"},
          "normalized_nearest_bound_distance": {"type": ["number", "null"]}
        }
      }
    },
    "raw_x": {"type": "array", "items": {"type": "number"}, "minItems": 9, "maxItems": 9},
    "fixed_parameters": {"type": "object"},
    "outcome": {
      "type": "object",
      "required": ["feasible", "penalized", "primary_code", "deepest_stage"],
      "properties": {
        "feasible": {"type": "boolean"},
        "penalized": {"type": "boolean"},
        "penalty_value": {"type": ["number", "null"]},
        "primary_code": {"type": "string"},
        "secondary_codes": {"type": "array", "items": {"type": "string"}},
        "deepest_stage": {"type": "string"},
        "stage_path": {"type": ["string", "null"]},
        "kpis": {"type": "object"}
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage_code", "code", "severity", "component", "class", "method", "message"],
        "properties": {
          "issue_id": {"type": ["string", "null"]},
          "stage_code": {"type": "string"},
          "code": {"type": "string"},
          "severity": {"enum": ["error", "warning"]},
          "component": {"type": "string"},
          "class": {"type": "string"},
          "method": {"type": "string"},
          "message": {"type": "string"},
          "values": {"type": "object"},
          "exception": {"type": ["object", "null"]}
        }
      }
    },
    "solver_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attempt_index", "component", "method", "solver_name", "success"],
        "properties": {
          "attempt_index": {"type": "integer"},
          "component": {"type": "string"},
          "method": {"type": "string"},
          "solver_name": {"type": "string"},
          "is_fallback": {"type": "boolean"},
          "fallback_from": {"type": ["string", "null"]},
          "x0": {"type": ["array", "null"], "items": {"type": "number"}},
          "bounds": {"type": ["object", "null"]},
          "solver_options": {"type": "object"},
          "x_final": {"type": ["array", "null"], "items": {"type": "number"}},
          "residual_vector": {"type": ["array", "null"], "items": {"type": "number"}},
          "residual_l2": {"type": ["number", "null"]},
          "residual_linf": {"type": ["number", "null"]},
          "residual_tol": {"type": ["number", "null"]},
          "success": {"type": "boolean"},
          "status": {"type": ["integer", "string", "null"]},
          "ier": {"type": ["integer", "null"]},
          "message": {"type": ["string", "null"]},
          "nfev": {"type": ["integer", "null"]},
          "njev": {"type": ["integer", "null"]},
          "nit": {"type": ["integer", "null"]},
          "elapsed_ms": {"type": ["number", "null"]}
        }
      }
    },
    "states": {"type": "object"},
    "timings": {"type": "object"},
    "reproduction": {
      "type": "object",
      "required": ["timestamp_utc", "git_commit", "git_dirty", "config_sha256", "python_version", "coolprop_version"],
      "properties": {
        "timestamp_utc": {"type": "string"},
        "timezone": {"type": ["string", "null"]},
        "git_commit": {"type": "string"},
        "git_dirty": {"type": "boolean"},
        "config_path": {"type": ["string", "null"]},
        "config_sha256": {"type": "string"},
        "cli_argv": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "python_version": {"type": "string"},
        "numpy_version": {"type": ["string", "null"]},
        "scipy_version": {"type": ["string", "null"]},
        "coolprop_version": {"type": "string"},
        "deap_version": {"type": ["string", "null"]},
        "platform": {"type": ["string", "null"]},
        "retry_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
